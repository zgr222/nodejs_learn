#!/usr/bin/env node

// 导入db函数，连接数据成功后再打开http服务
const db = require('../db/db')
db().then(() => {

  /**
   * Module dependencies.
   */

  const app = require('../app');
  const debug = require('debug')('stu-server:server');
  const http = require('http');

  /**
   * Get port from environment and store in Express.
   */

  const port = normalizePort(process.env.PORT || '8848');
  app.set('port', port);

  /**
   * Create HTTP server.
   */

  const server = http.createServer(app);

  /**
   * Create WebSocket server
   */
  const wss = new WebSocket.Server({ server });
  // WebSocket 逻辑
  wss.on('connection', (ws) => {
    console.log('Client connected');

    // 设置心跳属性
    ws.isAlive = true;

    ws.on('message', (message) => {
      const data = JSON.parse(message)
      if (data.data === 'pong') {
        // pong 响应，标记客户端仍然存活
        console.log('pong from vue');
        ws.isAlive = true
      } else {
        console.log(`Received: ${data.data}`);
        ws.send(`Server: ${data.data}`);
      }
    });

    ws.on('close', () => console.log('Client disconnected'));

    ws.on('error', (err) => {
      console.log('WebSocket error:', err);
      ws.close();
      if (pingInterval) clearInterval(pingInterval);
    });
  });
  
  // **心跳检测：定期发送 ping**
  const pingInterval = setInterval(() => {
    wss.clients.forEach((ws) => {
      if (!ws.isAlive) {
        console.log('Client did not respond, terminating connection');
        return ws.terminate(); // 关闭未响应的客户端连接
      }

      ws.isAlive = false; // 先标记为 false，等待客户端 pong 响应
      ws.send('ping'); // 发送 ping 请求
    });
  }, 10000); // 每 30 秒检测一次


  /**
   * Listen on provided port, on all network interfaces.
   */

  server.listen(port);
  server.on('error', onError);
  server.on('listening', onListening);

  /**
   * Normalize a port into a number, string, or false.
   */

  function normalizePort(val) {
    const port = parseInt(val, 10);

    if (isNaN(port)) {
      // named pipe
      return val;
    }

    if (port >= 0) {
      // port number
      return port;
    }

    return false;
  }

  /**
   * Event listener for HTTP server "error" event.
   */

  function onError(error) {
    if (error.syscall !== 'listen') {
      throw error;
    }

    const bind = typeof port === 'string'
      ? 'Pipe ' + port
      : 'Port ' + port;

    // handle specific listen errors with friendly messages
    switch (error.code) {
      case 'EACCES':
        console.error(bind + ' requires elevated privileges');
        process.exit(1);
        break;
      case 'EADDRINUSE':
        console.error(bind + ' is already in use');
        process.exit(1);
        break;
      default:
        throw error;
    }
  }

  /**
   * Event listener for HTTP server "listening" event.
   */

  function onListening() {
    const addr = server.address();
    const bind = typeof addr === 'string'
    ? 'pipe ' + addr
    : 'port ' + addr.port;
    debug('Listening on ' + bind);
  }
})
